{
  "swagger": "2.0",
  "info": {
    "title": "History Admission Events API",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "AdmissionHistory"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/api/v1/admission-event/by-filter/slice/{direction}": {
      "post": {
        "operationId": "AdmissionHistory_FilterAdmissionEventSlice",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/admission_historyListAdmissionEventSliceResp"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "direction",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/AdmissionHistoryFilterAdmissionEventSliceBody"
            }
          }
        ],
        "tags": [
          "AdmissionHistory"
        ]
      }
    },
    "/api/v1/admission-event/slice/{direction}": {
      "get": {
        "operationId": "AdmissionHistory_ListAdmissionEventSlice",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/admission_historyListAdmissionEventSliceResp"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "direction",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "date-time"
          },
          {
            "name": "sliceSize",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int64"
          }
        ],
        "tags": [
          "AdmissionHistory"
        ]
      }
    },
    "/api/v1/admission-event/{id}": {
      "get": {
        "operationId": "AdmissionHistory_Read",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/admission_eventAdmissionEvent"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "AdmissionHistory"
        ]
      }
    }
  },
  "definitions": {
    "AdmissionHistoryFilterAdmissionEventSliceBody": {
      "type": "object",
      "properties": {
        "cursor": {
          "type": "string",
          "format": "date-time"
        },
        "sliceSize": {
          "type": "integer",
          "format": "int64"
        },
        "filter": {
          "$ref": "#/definitions/admission_historyAdmissionFilter"
        }
      }
    },
    "KyvernoPolicyAction": {
      "type": "string",
      "enum": [
        "AUDIT",
        "ENFORCE"
      ],
      "default": "AUDIT",
      "description": "action defines what Kyverno does with a request violating the policy.\n\n - AUDIT: AUDIT only records the violation in a policy report, the request is allowed.\n - ENFORCE: ENFORCE denies the request. Kyverno reports blocked requests via Kubernetes events only,\nsee https://kyverno.io/docs/guides/reports/."
    },
    "admission_eventAdmissionEvent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "title": "id (as UUID) is generated by admission-monitor, so that it can be used in notifier templates\nwhen sending notifications, for building URL pointing to a particular event, or as a supplementary info"
        },
        "kyvernoVersion": {
          "type": "string"
        },
        "registeredAt": {
          "type": "string",
          "format": "date-time"
        },
        "resource": {
          "$ref": "#/definitions/admission_eventResource"
        },
        "threats": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/admission_eventThreat"
          }
        },
        "blocked": {
          "type": "boolean",
          "description": "blocked is true when Kyverno itself denied the request (policy action is ENFORCE)."
        },
        "isIncident": {
          "type": "boolean"
        },
        "incidentSeverity": {
          "type": "string"
        },
        "blockBy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notifyBy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "AdmissionEvent is a normalized result of a single Kyverno policy evaluation.\nIt is produced by admission-monitor and published to history-api the same way\nevent-processor publishes runtime_event.RuntimeEvent."
    },
    "admission_eventContainer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "imageName": {
          "type": "string"
        },
        "registry": {
          "type": "string"
        }
      }
    },
    "admission_eventPolicy": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "id is \"\u003cpolicy name\u003e/\u003crule name\u003e\", it is stable and is used to whitelist a threat in policy-enforcer rules."
        },
        "name": {
          "type": "string"
        },
        "rule": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "description": "source is reported by Kyverno, e.g. \"KyvernoValidatingPolicy\" or \"KyvernoImageValidatingPolicy\"."
        },
        "action": {
          "$ref": "#/definitions/KyvernoPolicyAction"
        }
      },
      "description": "Policy identifies the Kyverno policy and rule which produced the threat."
    },
    "admission_eventResource": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "uid": {
          "type": "string"
        },
        "nodeName": {
          "type": "string"
        },
        "containers": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/admission_eventContainer"
          }
        }
      },
      "description": "Resource describes the object the policy was evaluated against."
    },
    "admission_eventThreat": {
      "type": "object",
      "properties": {
        "policy": {
          "$ref": "#/definitions/admission_eventPolicy"
        },
        "severity": {
          "type": "string"
        }
      },
      "description": "Threat is a single failed policy rule. Kyverno policy plays the same role here\nas a WASM detector does in event-processor."
    },
    "admission_historyAdmissionFilter": {
      "type": "object",
      "properties": {
        "resourceKind": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resourceNamespace": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resourceName": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nodeName": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "containerNames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "imageNames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "period": {
          "$ref": "#/definitions/commonPeriod"
        },
        "blocked": {
          "type": "boolean"
        },
        "hasIncident": {
          "type": "boolean"
        },
        "threatsPolicies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Identifiers of Kyverno policies that produced the findings, as \"\u003cpolicy name\u003e/\u003crule name\u003e\".\nThis field does not support globs."
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Identifiers of worked rules. This field does not support globs."
        }
      }
    },
    "admission_historyListAdmissionEventSliceResp": {
      "type": "object",
      "properties": {
        "admissionEvents": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/admission_eventAdmissionEvent"
          }
        },
        "leftCursor": {
          "type": "string",
          "format": "date-time"
        },
        "rightCursor": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "commonPeriod": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "format": "date-time"
        },
        "to": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    }
  }
}
