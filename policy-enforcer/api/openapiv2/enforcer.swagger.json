        }
      }
    },
    "enforcerEvaluatePolicyRuntimeEventReqActionArgs": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string"
        },
        "pod": {
          "type": "string"
        },
        "container": {
          "type": "string"
        },
        "binary": {
          "type": "string"
        },
        "node": {
          "type": "string"
        },
        "imageName": {
          "type": "string"
        },
        "registry": {
          "type": "string"
        }
      }
    },
    "enforcerEvaluatePolicyRuntimeEventReqResult": {
      "type": "object",
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/enforcerEvaluatePolicyRuntimeEventReqResultEvent"
          }
        }
      }
    },
    "enforcerEvaluatePolicyRuntimeEventReqResultEvent": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "title": "name and version are not used at the moment and are added for consistency reasons and future purposes"
        },
        "version": {
          "type": "string"
        },
        "detectorId": {
          "type": "string",
          "title": "detector_id is identifier of detector which processes events within event-processor"
        },
        "severity": {
          "type": "string"
        },
