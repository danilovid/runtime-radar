          }
        }
      }
    },
    "enforcerEvaluatePolicyAdmissionReqResultEvent": {
      "type": "object",
      "properties": {
        "policyId": {
          "type": "string",
          "description": "policy_id is \"\u003cpolicy name\u003e/\u003crule name\u003e\" of the Kyverno policy which produced the finding.\nIt is the admission counterpart of detector_id and is whitelisted the same way."
        },
        "severity": {
          "type": "string"
        },
        "policy": {
          "$ref": "#/definitions/enforcerPolicy"
        }
      }
    },
    "enforcerEvaluatePolicyRuntimeEventReq": {
      "type": "object",
      "properties": {
        "actor": {
