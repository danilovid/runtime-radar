  "paths": {
    "/api/v1/evaluate-policy/admission": {
      "post": {
        "summary": "EvaluatePolicyAdmission returns EvaluatePolicyAdmissionReq enriched with evaluated policies.",
        "operationId": "Enforcer_EvaluatePolicyAdmission",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/enforcerEvaluatePolicyAdmissionReq"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/enforcerEvaluatePolicyAdmissionReq"
            }
          }
        ],
        "tags": [
          "Enforcer"
        ]
      }
    },
    "/api/v1/evaluate-policy/runtime": {
      "post": {
        "summary": "EvaluatePolicyRuntimeEvent returns EvaluatePolicyRuntimeEventReq enriched with evaluated policies.",
        "operationId": "Enforcer_EvaluatePolicyRuntimeEvent",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/enforcerEvaluatePolicyRuntimeEventReq"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/enforcerEvaluatePolicyRuntimeEventReq"
            }
          }
        ],
        "tags": [
          "Enforcer"
        ]
      }
    }
  },
  "definitions": {
    "ArgsContainer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "imageName": {
          "type": "string"
        },
        "registry": {
          "type": "string"
        }
      },
      "description": "A single admission event covers the whole resource, so unlike a runtime event it can carry\nmore than one container. A rule matches the event if it matches at least one of them."
    },
    "RuleJSONBlock": {
      "type": "object",
      "properties": {
        "severity": {
          "type": "string"
        }
      }
    },
    "RuleJSONNotify": {
      "type": "object",
      "properties": {
        "severity": {
          "type": "string"
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "RuleJSONWhitelist": {
      "type": "object",
      "properties": {
        "threats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "binaries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "RuleRuleJSON": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "block": {
          "$ref": "#/definitions/RuleJSONBlock"
        },
        "notify": {
          "$ref": "#/definitions/RuleJSONNotify"
        },
        "whitelist": {
          "$ref": "#/definitions/RuleJSONWhitelist"
        }
      }
    },
    "RuleScope": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "imageNames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "registries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "clusters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "namespaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pods": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "containers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
