      "type": "object",
      "properties": {
        "actor": {
          "type": "string"
        },
        "action": {
          "$ref": "#/definitions/enforcerEvaluatePolicyAdmissionReqAction"
        },
        "result": {
          "$ref": "#/definitions/enforcerEvaluatePolicyAdmissionReqResult"
        }
      }
    },
    "enforcerEvaluatePolicyAdmissionReqAction": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "args": {
          "$ref": "#/definitions/enforcerEvaluatePolicyAdmissionReqActionArgs"
        }
      }
    },
    "enforcerEvaluatePolicyAdmissionReqActionArgs": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string"
        },
        "pod": {
          "type": "string",
          "description": "pod holds the name of the resource the finding is about, which is not necessarily a pod."
        },
        "node": {
          "type": "string"
        },
        "containers": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/ArgsContainer"
          }
        }
      }
    },
    "enforcerEvaluatePolicyAdmissionReqResult": {
      "type": "object",
      "properties": {
        "events": {
          "type": "array",
          "items": {
