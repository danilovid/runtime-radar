        "scope": {
          "$ref": "#/definitions/RuleScope"
        }
      }
    },
    "ruleRuleType": {
      "type": "string",
      "enum": [
        "TYPE_RUNTIME",
        "TYPE_ADMISSION"
      ],
      "default": "TYPE_RUNTIME"
